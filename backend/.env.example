# WorkToDo backend configuration. Copy to `.env` (never commit `.env`) and edit. Loaded by `npm start` / `npm run dev`.
# Values below are DEVELOPMENT examples only. Do not reuse them in production.

# ---- Server -------------------------------------------------------------
# Only NODE_ENV=development exposes error details to clients. Use "production" when deployed.
NODE_ENV=development
PORT=5000
# HOST=127.0.0.1
# Set true only when running behind a trusted reverse proxy (needed for correct client IPs in rate limiting).
# TRUST_PROXY=false

# ---- Database (PostgreSQL 16 + Prisma) -----------------------------------
# If DATABASE_URL is unset only the stateless endpoints work (/, /health, /ready, POST /api/v1/recommendations).
# Local development database created by the setup guide (user "worktodo", database "worktodo"):
DATABASE_URL=postgresql://worktodo:CHANGE_ME_DEV_PASSWORD@localhost:5432/worktodo?schema=public

# ---- Authentication ------------------------------------------------------
# REQUIRED when DATABASE_URL is set. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Access token lifetime (seconds, 60-3600). Short-lived by design; it lives only in browser memory.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token (HttpOnly cookie) lifetime in days; "remember me" uses the longer value.
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Rate limit for login / register / forgot / reset / change-password (per client IP).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Cookies, CORS and CSRF ---------------------------------------------
# Comma-separated list of exact frontend origins allowed to call the API with credentials.
# Defaults (development/test only): http://localhost:5173,http://127.0.0.1:5173. REQUIRED in production/staging.
FRONTEND_ORIGIN=http://localhost:5173
# Defaults to true in production/staging, false otherwise. Must not be false in production.
# COOKIE_SECURE=false

# ---- Email ---------------------------------------------------------------
# "console" (development only): prints reset links to THIS SERVER'S LOG. Nothing is delivered.
# "none": sends nothing. No real delivery provider is implemented (see docs/EMAIL.md).
EMAIL_PROVIDER=console
# Public URL of the frontend, used to build password-reset links.
APP_URL=http://localhost:5173

# ---- Python ML service ---------------------------------------------------
# Required in production/staging; defaults to http://127.0.0.1:8000 in development/test.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=10000

# ---- Features ------------------------------------------------------------
# The unauthenticated, non-persisting POST /api/v1/recommendations is disabled by default when
# NODE_ENV=production AND DATABASE_URL is set. Override explicitly with true/false.
# ENABLE_STATELESS_RECOMMENDATIONS=true

# ---- Development seed (npm run db:seed; refuses to run in production) ---
# SEED_DEMO_PASSWORD=DemoPassword123
